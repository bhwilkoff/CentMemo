<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppName.App.App"
             xmlns:local="using:AppName.App"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system light/dark; FluentAvaloniaTheme gives the WinUI 11 look. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Design tokens: change design-tokens.json at the repository root and run
             `node tools/design_tokens.mjs`; every platform follows. Light and Dark
             follow the system theme. -->
        <ResourceDictionary>
            <!-- BEGIN design-tokens:resources. Generated from design-tokens.json by tools/design_tokens.mjs. Do not edit by hand. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BrandPrimary">#4A1520</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#4A1520"/>
                    <Color x:Key="BrandOnPrimary">#FBFAF7</Color>
                    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="#FBFAF7"/>
                    <Color x:Key="BrandBackground">#FBFAF7</Color>
                    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#FBFAF7"/>
                    <Color x:Key="BrandSurface">#FFFFFF</Color>
                    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#FFFFFF"/>
                    <Color x:Key="BrandSurfaceAlt">#F1EEEA</Color>
                    <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#F1EEEA"/>
                    <Color x:Key="BrandText">#231B1C</Color>
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#231B1C"/>
                    <Color x:Key="BrandTextMuted">#5E5455</Color>
                    <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#5E5455"/>
                    <Color x:Key="BrandBorder">#D9D2CF</Color>
                    <SolidColorBrush x:Key="BrandBorderBrush" Color="#D9D2CF"/>
                    <Color x:Key="SemanticSuccess">#1E7A4F</Color>
                    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="#1E7A4F"/>
                    <Color x:Key="SemanticWarning">#8A5A00</Color>
                    <SolidColorBrush x:Key="SemanticWarningBrush" Color="#8A5A00"/>
                    <Color x:Key="SemanticError">#B42318</Color>
                    <SolidColorBrush x:Key="SemanticErrorBrush" Color="#B42318"/>
                    <Color x:Key="SemanticErrorSurface">#FDECEA</Color>
                    <SolidColorBrush x:Key="SemanticErrorSurfaceBrush" Color="#FDECEA"/>
                    <Color x:Key="SemanticStoreClay">#B5523B</Color>
                    <SolidColorBrush x:Key="SemanticStoreClayBrush" Color="#B5523B"/>
                    <Color x:Key="SemanticStoreOchre">#A8761A</Color>
                    <SolidColorBrush x:Key="SemanticStoreOchreBrush" Color="#A8761A"/>
                    <Color x:Key="SemanticStoreSage">#2F7A6B</Color>
                    <SolidColorBrush x:Key="SemanticStoreSageBrush" Color="#2F7A6B"/>
                    <Color x:Key="SemanticStoreSlate">#3D5A9E</Color>
                    <SolidColorBrush x:Key="SemanticStoreSlateBrush" Color="#3D5A9E"/>
                    <Color x:Key="SemanticStoreRose">#A8437A</Color>
                    <SolidColorBrush x:Key="SemanticStoreRoseBrush" Color="#A8437A"/>
                    <Color x:Key="SemanticStoreStone">#6F6964</Color>
                    <SolidColorBrush x:Key="SemanticStoreStoneBrush" Color="#6F6964"/>
                    <Color x:Key="SemanticThemeClay">#A33E25</Color>
                    <SolidColorBrush x:Key="SemanticThemeClayBrush" Color="#A33E25"/>
                    <Color x:Key="SemanticThemePersimmon">#964D09</Color>
                    <SolidColorBrush x:Key="SemanticThemePersimmonBrush" Color="#964D09"/>
                    <Color x:Key="SemanticThemeOchre">#815C0A</Color>
                    <SolidColorBrush x:Key="SemanticThemeOchreBrush" Color="#815C0A"/>
                    <Color x:Key="SemanticThemeOlive">#686800</Color>
                    <SolidColorBrush x:Key="SemanticThemeOliveBrush" Color="#686800"/>
                    <Color x:Key="SemanticThemeMoss">#2F751D</Color>
                    <SolidColorBrush x:Key="SemanticThemeMossBrush" Color="#2F751D"/>
                    <Color x:Key="SemanticThemeSage">#1B735B</Color>
                    <SolidColorBrush x:Key="SemanticThemeSageBrush" Color="#1B735B"/>
                    <Color x:Key="SemanticThemeTeal">#157171</Color>
                    <SolidColorBrush x:Key="SemanticThemeTealBrush" Color="#157171"/>
                    <Color x:Key="SemanticThemeSky">#006D91</Color>
                    <SolidColorBrush x:Key="SemanticThemeSkyBrush" Color="#006D91"/>
                    <Color x:Key="SemanticThemeSlate">#2F60B2</Color>
                    <SolidColorBrush x:Key="SemanticThemeSlateBrush" Color="#2F60B2"/>
                    <Color x:Key="SemanticThemeIris">#6451AC</Color>
                    <SolidColorBrush x:Key="SemanticThemeIrisBrush" Color="#6451AC"/>
                    <Color x:Key="SemanticThemePlum">#8A428E</Color>
                    <SolidColorBrush x:Key="SemanticThemePlumBrush" Color="#8A428E"/>
                    <Color x:Key="SemanticThemeRose">#9D3A67</Color>
                    <SolidColorBrush x:Key="SemanticThemeRoseBrush" Color="#9D3A67"/>
                    <Color x:Key="SemanticThemeStone">#6F6964</Color>
                    <SolidColorBrush x:Key="SemanticThemeStoneBrush" Color="#6F6964"/>
                    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#43131D"/>
                    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#3B111A"/>
                    <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="#664A1520"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BrandPrimary">#F0B9BE</Color>
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#F0B9BE"/>
                    <Color x:Key="BrandOnPrimary">#4A1520</Color>
                    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="#4A1520"/>
                    <Color x:Key="BrandBackground">#171615</Color>
                    <SolidColorBrush x:Key="BrandBackgroundBrush" Color="#171615"/>
                    <Color x:Key="BrandSurface">#201E1D</Color>
                    <SolidColorBrush x:Key="BrandSurfaceBrush" Color="#201E1D"/>
                    <Color x:Key="BrandSurfaceAlt">#2A2826</Color>
                    <SolidColorBrush x:Key="BrandSurfaceAltBrush" Color="#2A2826"/>
                    <Color x:Key="BrandText">#EFE9E7</Color>
                    <SolidColorBrush x:Key="BrandTextBrush" Color="#EFE9E7"/>
                    <Color x:Key="BrandTextMuted">#B8AEAC</Color>
                    <SolidColorBrush x:Key="BrandTextMutedBrush" Color="#B8AEAC"/>
                    <Color x:Key="BrandBorder">#3A3634</Color>
                    <SolidColorBrush x:Key="BrandBorderBrush" Color="#3A3634"/>
                    <Color x:Key="SemanticSuccess">#5CC593</Color>
                    <SolidColorBrush x:Key="SemanticSuccessBrush" Color="#5CC593"/>
                    <Color x:Key="SemanticWarning">#E8B04B</Color>
                    <SolidColorBrush x:Key="SemanticWarningBrush" Color="#E8B04B"/>
                    <Color x:Key="SemanticError">#FF8A80</Color>
                    <SolidColorBrush x:Key="SemanticErrorBrush" Color="#FF8A80"/>
                    <Color x:Key="SemanticErrorSurface">#3A1D1B</Color>
                    <SolidColorBrush x:Key="SemanticErrorSurfaceBrush" Color="#3A1D1B"/>
                    <Color x:Key="SemanticStoreClay">#E58A72</Color>
                    <SolidColorBrush x:Key="SemanticStoreClayBrush" Color="#E58A72"/>
                    <Color x:Key="SemanticStoreOchre">#E2B550</Color>
                    <SolidColorBrush x:Key="SemanticStoreOchreBrush" Color="#E2B550"/>
                    <Color x:Key="SemanticStoreSage">#6CC2AE</Color>
                    <SolidColorBrush x:Key="SemanticStoreSageBrush" Color="#6CC2AE"/>
                    <Color x:Key="SemanticStoreSlate">#8EA8E6</Color>
                    <SolidColorBrush x:Key="SemanticStoreSlateBrush" Color="#8EA8E6"/>
                    <Color x:Key="SemanticStoreRose">#E48BBB</Color>
                    <SolidColorBrush x:Key="SemanticStoreRoseBrush" Color="#E48BBB"/>
                    <Color x:Key="SemanticStoreStone">#B3ACA6</Color>
                    <SolidColorBrush x:Key="SemanticStoreStoneBrush" Color="#B3ACA6"/>
                    <Color x:Key="SemanticThemeClay">#FCA48D</Color>
                    <SolidColorBrush x:Key="SemanticThemeClayBrush" Color="#FCA48D"/>
                    <Color x:Key="SemanticThemePersimmon">#FEA668</Color>
                    <SolidColorBrush x:Key="SemanticThemePersimmonBrush" Color="#FEA668"/>
                    <Color x:Key="SemanticThemeOchre">#E9B452</Color>
                    <SolidColorBrush x:Key="SemanticThemeOchreBrush" Color="#E9B452"/>
                    <Color x:Key="SemanticThemeOlive">#C3C55A</Color>
                    <SolidColorBrush x:Key="SemanticThemeOliveBrush" Color="#C3C55A"/>
                    <Color x:Key="SemanticThemeMoss">#90D281</Color>
                    <SolidColorBrush x:Key="SemanticThemeMossBrush" Color="#90D281"/>
                    <Color x:Key="SemanticThemeSage">#54D8B1</Color>
                    <SolidColorBrush x:Key="SemanticThemeSageBrush" Color="#54D8B1"/>
                    <Color x:Key="SemanticThemeTeal">#2AD7D7</Color>
                    <SolidColorBrush x:Key="SemanticThemeTealBrush" Color="#2AD7D7"/>
                    <Color x:Key="SemanticThemeSky">#60CCFC</Color>
                    <SolidColorBrush x:Key="SemanticThemeSkyBrush" Color="#60CCFC"/>
                    <Color x:Key="SemanticThemeSlate">#98BFFE</Color>
                    <SolidColorBrush x:Key="SemanticThemeSlateBrush" Color="#98BFFE"/>
                    <Color x:Key="SemanticThemeIris">#BCB3FA</Color>
                    <SolidColorBrush x:Key="SemanticThemeIrisBrush" Color="#BCB3FA"/>
                    <Color x:Key="SemanticThemePlum">#E8A0EC</Color>
                    <SolidColorBrush x:Key="SemanticThemePlumBrush" Color="#E8A0EC"/>
                    <Color x:Key="SemanticThemeRose">#FF99C2</Color>
                    <SolidColorBrush x:Key="SemanticThemeRoseBrush" Color="#FF99C2"/>
                    <Color x:Key="SemanticThemeStone">#B3ACA6</Color>
                    <SolidColorBrush x:Key="SemanticThemeStoneBrush" Color="#B3ACA6"/>
                    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#D8A7AB"/>
                    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#C09498"/>
                    <SolidColorBrush x:Key="BrandPrimaryDisabledBrush" Color="#66F0B9BE"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="Space1">4</x:Double>
            <x:Double x:Key="Space2">8</x:Double>
            <x:Double x:Key="Space3">12</x:Double>
            <x:Double x:Key="Space4">16</x:Double>
            <x:Double x:Key="Space6">24</x:Double>
            <x:Double x:Key="Space8">32</x:Double>
            <CornerRadius x:Key="RadiusControl">8</CornerRadius>
            <CornerRadius x:Key="RadiusCard">12</CornerRadius>
            <!-- END design-tokens:resources -->
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- The brand accent (instead of the default purple) and the type ramp. -->
        <!-- BEGIN design-tokens:styles. Generated from design-tokens.json by tools/design_tokens.mjs. Do not edit by hand. -->
        <sty:FluentAvaloniaTheme CustomAccentColor="#4A1520" />

        <!-- The six-level type ramp, adopted via Classes. Refuse a seventh level. -->
        <Style Selector="TextBlock.view-heading"> <!-- L1 pageTitle -->
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.section-header"> <!-- L2 sectionHeader -->
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.body-strong"> <!-- L3 bodyStrong -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.body"> <!-- L4 body -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style Selector="TextBlock.caption"> <!-- L5 caption -->
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandTextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.tabular"> <!-- L6 tabular -->
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace"/>
        </Style>
        <!-- END design-tokens:styles -->

        <!-- Reusable design-token styles — one definition, many views. Adopt via
             Classes="card" etc.; never restyle at a call site. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
            <Setter Property="Padding" Value="20"/>
            <!-- The card owns its elevation shadow — never hand-add shadow padding at
                 a call site. Kept subtle so it reads native on Fluent. -->
            <Setter Property="BoxShadow" Value="0 1 8 0 #1A000000"/>
        </Style>

        <!-- The brand CTA. FluentAvalonia derives a LIGHTER accent for the dark theme
             (AccentFillColorDefaultBrush -> Light1/2/3), which washes a brand-colored
             hero out while hard-coded brand fills beside it stay saturated — adjacent
             CTAs disagreeing. The brand primary is a token on every platform (one value
             for light, one for dark, from design-tokens.json), so pin it here. Fluent's derived accent still drives focus rings and
             selection, which is the correct native behaviour for those. -->
        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryHoverBrush}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryPressedBrush}"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryDisabledBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOnPrimaryBrush}"/>
        </Style>
        <!-- Same rule, different control: a switched-on ToggleSwitch is an accent
             surface too. Pin the "on" fill in both themes. -->
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.chunky">
            <Setter Property="Padding" Value="24,13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        </Style>

    </Application.Styles>
</Application>
