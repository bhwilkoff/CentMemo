{
  "$about": "The one source of the app's look. Change a value here, run `node tools/design_tokens.mjs`, and every platform's token file is rewritten to match; `node tools/test_design_tokens.mjs` fails if any of them drifts. CentMemo: paper and ink, a sanguine pencil (#4A1520), and one bold color the person chooses used only as a mark (Decision 060, docs/DESIGN.md C1-C6). `grounds` lists the choices.",
  "color": {
    "brand": {
      "primary": {
        "light": "#4A1520",
        "dark": "#F0B9BE",
        "use": "the pencil: titles, actions, selection, drawn marks (DESIGN C2)"
      },
      "onPrimary": {
        "light": "#FBFAF7",
        "dark": "#4A1520",
        "use": "text and icons on primary"
      },
      "background": {
        "light": "#FBFAF7",
        "dark": "#171615",
        "use": "the page: paper (DESIGN C1)"
      },
      "surface": {
        "light": "#FFFFFF",
        "dark": "#201E1D",
        "use": "cards for long reading and writing: the memo, story entries"
      },
      "surfaceAlt": {
        "light": "#F1EEEA",
        "dark": "#2A2826",
        "use": "quiet fills: unselected chips, hover"
      },
      "text": {
        "light": "#231B1C",
        "dark": "#EFE9E7",
        "use": "ink: body text"
      },
      "textMuted": {
        "light": "#5E5455",
        "dark": "#B8AEAC",
        "use": "secondary text, captions"
      },
      "border": {
        "light": "#D9D2CF",
        "dark": "#3A3634",
        "use": "hairlines and outlines"
      }
    },
    "semantic": {
      "success": {
        "light": "#1E7A4F",
        "dark": "#5CC593",
        "use": "money in (credits); an operation that worked"
      },
      "warning": {
        "light": "#8A5A00",
        "dark": "#E8B04B",
        "use": "something needs attention"
      },
      "error": {
        "light": "#B42318",
        "dark": "#FF8A80",
        "use": "something failed"
      },
      "errorSurface": {
        "light": "#FDECEA",
        "dark": "#3A1D1B",
        "use": "the error banner's fill"
      },
      "storeClay": {
        "light": "#B5523B",
        "dark": "#E58A72",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      },
      "storeOchre": {
        "light": "#A8761A",
        "dark": "#E2B550",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      },
      "storeSage": {
        "light": "#2F7A6B",
        "dark": "#6CC2AE",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      },
      "storeSlate": {
        "light": "#3D5A9E",
        "dark": "#8EA8E6",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      },
      "storeRose": {
        "light": "#A8437A",
        "dark": "#E48BBB",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      },
      "storeStone": {
        "light": "#6F6964",
        "dark": "#B3ACA6",
        "use": "store tile mark: which store, by Money.merchantHue order (D8); a 2pt pencil mark, never a fill or text"
      }
    }
  },
  "font": {
    "body": {
      "web": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "native": "the platform's system face (SF Pro, Roboto, Segoe UI Variable)"
    },
    "mono": {
      "web": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
