{
  "$about": "The one source of the app's look. Change a value here, run `node tools/design_tokens.mjs`, and every platform's token file is rewritten to match; `node tools/test_design_tokens.mjs` fails if any of them drifts. CentMemo: a sanguine pencil (#4A1520) on a bold ground the person chooses (Decision 059; docs/research/color-search.md). `background` is the default ground (aqua); `grounds` lists every choice.",
  "color": {
    "brand": {
      "primary": {
        "light": "#4A1520",
        "dark": "#F5D6D8",
        "use": "the pencil: actions, the selected item, drawn marks"
      },
      "onPrimary": {
        "light": "#FBFAF7",
        "dark": "#4A1520",
        "use": "text and icons on primary"
      },
      "background": {
        "light": "#2FD4EC",
        "dark": "#131B1C",
        "use": "the page: the default ground (aqua); the person may choose another from grounds"
      },
      "surface": {
        "light": "#FBFAF7",
        "dark": "#1C2426",
        "use": "paper: the memo, forms, cards"
      },
      "surfaceAlt": {
        "light": "#EFEDE8",
        "dark": "#273031",
        "use": "a quieter paper, chips, hover"
      },
      "text": {
        "light": "#4A1520",
        "dark": "#F5D6D8",
        "use": "body text, in sanguine"
      },
      "textMuted": {
        "light": "#6E2B36",
        "dark": "#D8B0B4",
        "use": "secondary text, captions"
      },
      "border": {
        "light": "#8E5C63",
        "dark": "#4A5658",
        "use": "hairlines and outlines"
      }
    },
    "semantic": {
