      },
      "warning": {
        "light": "#5A3A00",
        "dark": "#F3C26B",
        "use": "something needs attention"
      },
      "error": {
        "light": "#8E1414",
        "dark": "#FFB4AB",
        "use": "something failed"
      },
      "errorSurface": {
        "light": "#FDECEA",
        "dark": "#3A1D1B",
        "use": "the error banner's fill"
      }
    }
  },
